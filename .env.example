
NEXT_PUBLIC_SUPABASE_URL=321323
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=3123

# Obavezno za worker (Project Settings → API → service_role) – nikad u frontend
SUPABASE_SERVICE_ROLE_KEY=1

TELEGRAM_BOT_TOKEN=13123
# Korisničko ime bota bez @ — za deep link i POST /api/telegram/connect
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Za Google OAuth mora odgovarati originu na kom radi app (isti URL kao u browseru).

# Tajni token za GET /api/worker (Authorization: Bearer <secret>).
# Na Vercel-u možeš koristiti i CRON_SECRET (platforma ga automatski šalje cron pozivu).
WORKER_CRON_SECRET=replace-me

# Scraper: šablon pretrage (zamenjuje {keyword}; podrazumevano u kodu je EUR + sort po ceni)
# KP_SEARCH_URL_TEMPLATE=https://www.kupujemprodajem.com/pretraga?keywords={keyword}&ignoreUserId=no&order=price&page=1&currency=eur
# Opciono: fiksni filter kategorije (npr. procesori) – ID iz URL-a na KP
# KP_SEARCH_FILTER_ID=

# Koliko stranica KP pretrage da se učita po skenu (1–10). Podrazumevano 2 = više pogodaka sa liste.
# KP_SEARCH_MAX_PAGE=2

# User-Agent za HTTP zahteve
SCRAPER_USER_AGENT=notifyKP/1.0 (contact@example.com)

# Cheerio selektori (JSON) – prilagodite DOM-u sajta
# listingSelector: kontejner jednog oglasa
# idAttr, titleSel, priceSel, locationSel, linkSel: unutar kontejnera
# Za KP (React) podrazumevano u kodu već odgovara DOM-u; override samo ako sajt promeni klase.
# KP_SCRAPER_SELECTORS={"listingSelector":"article[class*='AdItem']","titleSel":"[class*='AdItem_name']","priceSel":"[class*='AdItem_price']","locationSel":"[class*='originAndPromoLocation'] p","linkSel":"[class*='AdItem_descriptionHolder'] a[href*='/oglas/']"}
